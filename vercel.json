{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next",
      "config": {
        "distDir": ".next"
      }
    },
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "backend/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "backend/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "frontend/$1"
    }
  ]
}
